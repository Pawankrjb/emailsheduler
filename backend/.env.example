# Ethereal Email Fake SMTP (Leave blank to automatically generate fresh test account)
ETHEREAL_USER=
ETHEREAL_PASS=

# Slack Integration (Optional for live alert dispatch)
SLACK_WEBHOOK_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback

FRONTEND_URL=http://localhost:5173
